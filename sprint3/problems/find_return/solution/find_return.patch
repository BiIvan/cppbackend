+TEST_CASE("State serializes empty and populated bags", "[api][find-return]") {
+    Fixture fixture;
+    const auto token = fixture.Join("map1");
+    auto state = fixture.State(token);
+    REQUIRE(state.at("players").as_object().size() == 1);
+    CHECK(state.at("players").as_object().begin()->value().as_object().at("bag").as_array().empty());
+    auto* player = fixture.handler->GetApplication().FindPlayerByToken(model::Token{token});
+    REQUIRE(player != nullptr);
+    REQUIRE(player->GetDog().TryCollect({9, 1, {}}, 3));
+    REQUIRE(player->GetDog().TryCollect({8, 0, {}}, 3));
+    state = fixture.State(token);
+    const auto& bag = state.at("players").as_object().begin()->value().as_object().at("bag").as_array();
+    REQUIRE(bag.size() == 2);
+    CHECK(json::value_to<std::uint64_t>(bag[0].as_object().at("id")) == 9);
+    CHECK(json::value_to<unsigned>(bag[0].as_object().at("type")) == 1);
+    CHECK(json::value_to<std::uint64_t>(bag[1].as_object().at("id")) == 8);
+    CHECK(json::value_to<unsigned>(bag[1].as_object().at("type")) == 0);
+    player->GetDog().ReturnLoot();
+    state = fixture.State(token);
+    CHECK(state.at("players").as_object().begin()->value().as_object().at("bag").as_array().empty());
+}
